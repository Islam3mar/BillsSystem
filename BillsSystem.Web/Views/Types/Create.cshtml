@model BillsSystem.Web.ViewModels.ItemTypeFormViewModel
@{
    ViewData["Title"] = "Types Form";
}

<div class="form-card">
    <h4>Types Form</h4>
    <p class="form-subtitle">This is the basic horizontal form with labels on left and cost estimation form is the default position.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label asp-for="CompanyId"></label>
            <div class="flex-grow-1">
                <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
                    <option value="">choose from Companies</option>
                </select>
                <span asp-validation-for="CompanyId" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <label asp-for="Name"></label>
            <div class="flex-grow-1">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>
        <div class="form-row">
            <label asp-for="Notes"></label>
            <div class="flex-grow-1">
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="form-actions">
            <a asp-action="Index" class="btn btn-cancel"><i class="bi bi-trash"></i> Cancel</a>
            <button type="submit" class="btn btn-save"><i class="bi bi-pencil-square"></i> Save</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
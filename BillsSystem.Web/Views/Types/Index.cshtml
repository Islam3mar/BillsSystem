@model IEnumerable<BillsSystem.Domain.Entities.ItemType>
@{
    ViewData["Title"] = "Types";

    const string Cols = "<colgroup><col style=\"width:22%\"><col style=\"width:28%\"><col><col style=\"width:150px\"></colgroup>";

    async Task RowActions(BillsSystem.Domain.Entities.ItemType row)
    {
        <a href="@Url.Action("Edit", new { id = row.Id })" class="btn btn-sm btn-outline-secondary">Edit</a>
        <form action="@Url.Action("Delete", new { id = row.Id })" method="post" class="d-inline"
              onsubmit="return confirmDelete(this, 'Are you sure you want to delete this type?');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
    }

    // تجميع باسم الشركة: الشركات أبجديًا، والأنواع جوّاها أبجديًا
    var groups = Model
        .GroupBy(x => x.CompanyId)
        .Select(g => g.OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList())
        .OrderBy(g => g[0].Company.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Types</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> Add New Type</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="list-card cat-wrap">
    <table class="table mb-0 cat-table">
        @Html.Raw(Cols)
        <thead>
            <tr>
                <th>Company</th>
                <th>Type Name</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!groups.Any())
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No types added yet</td></tr>
            }
            @foreach (var group in groups)
            {
                if (group.Count == 1)
                {
                    var one = group[0];
                    <tr>
                        <td class="company-cell">@one.Company.Name</td>
                        <td>@one.Name</td>
                        <td>@one.Notes</td>
                        <td class="text-center">@{
                            await RowActions(one);
                        }
                    </td>
                </tr>
            }
                else
            {
                var groupId = "types-grp-" + group[0].CompanyId;
                <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                    role="button" aria-expanded="false" aria-controls="@groupId">
                    <td colspan="2">
                        <div class="group-title">
                            <i class="bi bi-chevron-right group-arrow"></i>
                            <span class="group-name">@group[0].Company.Name</span>
                            <span class="group-count">@group.Count types</span>
                        </div>
                    </td>
                    <td></td>
                    <td class="text-center"><span class="group-toggle">Details <i class="bi bi-chevron-down"></i></span></td>
                </tr>
                <tr class="client-group-details">
                    <td colspan="4">
                        <div class="collapse" id="@groupId">
                            <table class="table table-sm mb-0 client-subtable">
                                @Html.Raw(Cols)
                                <tbody>
                                    @foreach (var row in group)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>@row.Name</td>
                                            <td>@row.Notes</td>
                                            <td class="text-center">@{
                                                await RowActions(row);
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
        }
    }
</tbody>
</table>
</div>

@model BillsSystem.Web.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="page-head">
    <div>
        <h4>Overview</h4>
        <p>@BillsSystem.Domain.Common.AppClock.Today.ToString("dddd, d MMMM yyyy")</p>
    </div>
    <a asp-controller="Bills" asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> New Invoice</a>
</div>

<!-- ===== KPI Cards ===== -->
<div class="row g-3">
    <div class="col-lg-6">
        <div class="kpi-card kpi-hero">
            <div>
                <div class="kpi-label">Net Sales This Month</div>
                <div class="kpi-value">@Model.MonthNetSales.ToString("N2")</div>
            </div>
            <div class="kpi-meta"><strong>@Model.MonthBillsCount</strong> @(Model.MonthBillsCount == 1 ? "invoice" : "invoices") issued this month</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="kpi-icon kpi-amber"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="kpi-label">Outstanding</div>
                <div class="kpi-value">@Model.OutstandingAllTime.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="kpi-card h-100">
            <div class="kpi-icon kpi-violet"><i class="bi bi-people"></i></div>
            <div>
                <div class="kpi-label">Total Clients</div>
                <div class="kpi-value">@Model.TotalClients</div>
            </div>
        </div>
    </div>
</div>

<!-- ===== Quick Actions ===== -->
<div class="row g-3 mt-1">
    <div class="col-6 col-lg-3">
        <a asp-controller="Bills" asp-action="Create" class="quick-action">
            <i class="bi bi-plus-circle"></i> New Invoice
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Clients" asp-action="Create" class="quick-action">
            <i class="bi bi-person-plus"></i> New Client
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="Items" asp-action="Create" class="quick-action">
            <i class="bi bi-box-seam"></i> New Item
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a asp-controller="SalesReport" asp-action="Index" class="quick-action">
            <i class="bi bi-bar-chart"></i> Sales Report
        </a>
    </div>
</div>

<!-- ===== Recent Bills ===== -->
<div class="list-card mt-4">
    <div class="card-head">
        <h6>Recent Invoices</h6>
        <a asp-controller="Bills" asp-action="Index">View all</a>
    </div>
    @if (!Model.RecentBills.Any())
    {
        <p class="text-muted mb-0 pt-1">No invoices yet — create your first one from Quick Actions above.</p>
    }
    else
    {
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th>Bill #</th>
                    <th>Date</th>
                    <th>Client</th>
                    <th class="text-end">The Net</th>
                    <th class="text-end">The Rest</th>
                    <th></th>
                </tr>
            </thead>
            @{
                var recentGroups = Model.RecentBills
                    .GroupBy(b => b.ClientName)
                    .Select(g => g.OrderByDescending(b => b.Id).ToList())
                    .OrderByDescending(g => g.Max(b => b.Id))
                    .ToList();
            }
            <tbody>
                @foreach (var group in recentGroups)
                {
                    if (group.Count == 1)
                    {
                        var bill = group[0];
                        <tr>
                            <td>@bill.Id</td>
                            <td>@bill.BillDate.ToString("yyyy/MM/dd")</td>
                            <td>@bill.ClientName</td>
                            <td class="text-end">@bill.TheNet.ToString("0.00")</td>
                            <td class="text-end">@bill.TheRest.ToString("0.00")</td>
                            <td>
                                <a asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        var groupId = "home-grp-" + group[0].Id;
                        <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                            role="button" aria-expanded="false" aria-controls="@groupId">
                            <td colspan="2"><i class="bi bi-chevron-right group-arrow"></i>@group.Count invoices</td>
                            <td>@group[0].ClientName</td>
                            <td class="text-end">@group.Sum(b => b.TheNet).ToString("0.00")</td>
                            <td class="text-end">@group.Sum(b => b.TheRest).ToString("0.00")</td>
                            <td><span class="btn btn-sm btn-outline-secondary">View all</span></td>
                        </tr>
                        <tr class="client-group-details">
                            <td colspan="6">
                                <div class="collapse" id="@groupId">
                                    <table class="table table-sm mb-0 client-subtable">
                                        <tbody>
                                            @foreach (var bill in group)
                                            {
                                                <tr>
                                                    <td>@bill.Id</td>
                                                    <td>@bill.BillDate.ToString("yyyy/MM/dd")</td>
                                                    <td>@bill.ClientName</td>
                                                    <td class="text-end">@bill.TheNet.ToString("0.00")</td>
                                                    <td class="text-end">@bill.TheRest.ToString("0.00")</td>
                                                    <td>
                                                        <a asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>
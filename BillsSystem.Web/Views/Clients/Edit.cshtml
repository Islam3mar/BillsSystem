@model BillsSystem.Web.ViewModels.ClientFormViewModel
@{
    ViewData["Title"] = "Edit Client";
}

<div class="form-card">
    <h4>Clients</h4>
    <p class="form-subtitle">Edit the selected client's data below.</p>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="form-row">
            <label asp-for="Name"></label>
            <div class="flex-grow-1">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Phone"></label>
            <div class="flex-grow-1">
                <input asp-for="Phone" class="form-control" maxlength="11" placeholder="01xxxxxxxxx" />
                <span asp-validation-for="Phone" class="text-danger"></span>
                <small class="text-muted">Accepted prefixes: 010, 011, 012, 015</small>
            </div>
        </div>

        <div class="form-row">
            <label>NUMBER</label>
            <div class="flex-grow-1">
                <input class="form-control" value="@Model.Id" disabled />
            </div>
        </div>

        <div class="form-row">
            <label asp-for="Address"></label>
            <div class="flex-grow-1">
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-cancel"><i class="bi bi-trash"></i> Cancel</a>
            <button type="submit" class="btn btn-save"><i class="bi bi-pencil-square"></i> Save</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
@using BillsSystem.Domain.Helpers

@model BillsSystem.Application.DTOs.PagedResult<BillsSystem.Domain.Entities.Client>
@{
    ViewData["Title"] = "Clients";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Clients</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> Add New Client</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small text-muted mb-1">SEARCH</label>
        <input name="search" value="@search" class="form-control" style="min-width:280px"
               placeholder="Name, phone, email or address" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-save"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-cancel">Reset</a>
    </div>
</form>

<div class="list-card">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Number</th>
                <th>Client Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Network</th>
                <th>Address</th>
                <th>Credit Limit</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">@(string.IsNullOrWhiteSpace(search) ? "No clients added yet" : "No clients match your search")</td></tr>
            }
            @foreach (var client in Model.Items)
            {
                var whatsAppUrl = EgyptianMobilePrefixHelper.ToWhatsAppUrl(client.Phone);
                var hasEmail = !string.IsNullOrWhiteSpace(client.Email);
                var gmailUrl = hasEmail
                    ? "https://mail.google.com/mail/?view=cm&fs=1&to=" + Uri.EscapeDataString(client.Email!.Trim())
                    : null;
                var networkClass = client.Network switch
                {
                    "Vodafone" => "net-vodafone",
                    "Etisalat" => "net-etisalat",
                    "Orange" => "net-orange",
                    "WE" => "net-we",
                    _ => "bg-secondary"
                };
                <tr>
                    <td>@client.Id</td>
                    <td>@client.Name</td>
                    <td>@client.Phone</td>
                    <td>
                        @if (hasEmail)
                        {
                            <a href="@gmailUrl" target="_blank" rel="noopener noreferrer"
                               title="Compose email in Gmail">@client.Email</a>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td><span class="badge @networkClass">@client.Network</span></td>
                    <td>@client.Address</td>
                    <td>@(client.MaxCreditLimit.HasValue ? client.MaxCreditLimit.Value.ToString("N2") : "No limit")</td>
                    <td class="text-center">
                        @if (whatsAppUrl != null)
                        {
                            <a href="@whatsAppUrl" target="_blank" rel="noopener noreferrer"
                               class="btn btn-sm btn-outline-success" title="Open WhatsApp chat">
                                <i class="bi bi-whatsapp"></i>
                            </a>
                        }

                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@client.Id" method="post" class="d-inline"
                              onsubmit="return confirmDelete(this, 'Are you sure you want to delete this client?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount clients)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

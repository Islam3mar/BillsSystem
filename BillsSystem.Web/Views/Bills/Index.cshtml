@model BillsSystem.Application.DTOs.PagedResult<BillsSystem.Domain.Entities.Bill>
@{
    ViewData["Title"] = "Sales Invoices";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sales Invoices</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> New Invoice</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="search" value="@search" class="form-control" placeholder="Bill number or client name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-save"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-cancel">Reset</a>
    </div>
</form>

<div class="list-card">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Bill Number</th>
                <th>Bill Date</th>
                <th>Client</th>
                <th>Bills Total</th>
                <th>The Net</th>
                <th>Paid Up</th>
                <th>The Rest</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        @{
            var billGroups = Model.Items
                .GroupBy(b => b.ClientId)
                .Select(g => g.OrderByDescending(b => b.Id).ToList())
                .OrderByDescending(g => g.Max(b => b.Id))
                .ToList();
        }
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No invoices found</td></tr>
            }
            @foreach (var group in billGroups)
            {
                if (group.Count == 1)
                {
                    var bill = group[0];
                    <tr>
                        <td>@bill.Id</td>
                        <td>@bill.BillDate.ToString("yyyy/MM/dd")</td>
                        <td>@bill.Client.Name</td>
                        <td>@bill.BillsTotal.ToString("0.00")</td>
                        <td>@bill.TheNet.ToString("0.00")</td>
                        <td>@bill.PaidUp.ToString("0.00")</td>
                        <td>@bill.TheRest.ToString("0.00")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <form asp-action="Delete" asp-route-id="@bill.Id" method="post" class="d-inline"
                                onsubmit="return confirmDelete(this, 'Delete this invoice? It will be hidden from reports and its stock will be returned.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                else
                {
                    var groupId = "bills-grp-" + group[0].Id;
                    <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                        role="button" aria-expanded="false" aria-controls="@groupId">
                        <td colspan="2"><i class="bi bi-chevron-right group-arrow"></i>@group.Count invoices <small class="text-muted">(on this page)</small></td>
                        <td>@group[0].Client.Name</td>
                        <td>@group.Sum(b => b.BillsTotal).ToString("0.00")</td>
                        <td>@group.Sum(b => b.TheNet).ToString("0.00")</td>
                        <td>@group.Sum(b => b.PaidUp).ToString("0.00")</td>
                        <td>@group.Sum(b => b.TheRest).ToString("0.00")</td>
                        <td class="text-center"><span class="btn btn-sm btn-outline-secondary">View all</span></td>
                    </tr>
                    <tr class="client-group-details">
                        <td colspan="8">
                            <div class="collapse" id="@groupId">
                                <table class="table table-sm mb-0 client-subtable">
                                    <tbody>
                                        @foreach (var bill in group)
                                        {
                                            <tr>
                                                <td>@bill.Id</td>
                                                <td>@bill.BillDate.ToString("yyyy/MM/dd")</td>
                                                <td>@bill.Client.Name</td>
                                                <td>@bill.BillsTotal.ToString("0.00")</td>
                                                <td>@bill.TheNet.ToString("0.00")</td>
                                                <td>@bill.PaidUp.ToString("0.00")</td>
                                                <td>@bill.TheRest.ToString("0.00")</td>
                                                <td class="text-center">
                                                    <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                                    <form asp-action="Delete" asp-route-id="@bill.Id" method="post" class="d-inline"
                                                          onsubmit="return confirmDelete(this, 'Delete this invoice? It will be hidden from reports and its stock will be returned.');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount invoices)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

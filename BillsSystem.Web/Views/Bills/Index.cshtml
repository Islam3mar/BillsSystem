@model BillsSystem.Application.DTOs.PagedResult<BillsSystem.Domain.Entities.Bill>
@{
    ViewData["Title"] = "Sales Invoices";
    var search = ViewBag.Search as string;
    var fromDate = ViewBag.From as DateTime?;
    var toDate = ViewBag.To as DateTime?;
    var fromText = fromDate?.ToString("yyyy-MM-dd");
    var toText = toDate?.ToString("yyyy-MM-dd");

    // عرض أسماء الأصناف جوه خلية الفاتورة
    void Lines(BillsSystem.Domain.Entities.Bill b)
    {
        foreach (var l in b.Items.OrderBy(i => i.Id))
        {
            <div class="bill-line"><span class="bill-line-name">@l.ItemName</span> <span class="bill-line-qty">&times; @l.Quantity</span></div>
        }
    }
    const string Cols = "<colgroup><col style=\"width:6%\"><col style=\"width:9%\"><col style=\"width:15%\"><col style=\"width:20%\"><col style=\"width:10%\"><col style=\"width:10%\"><col style=\"width:10%\"><col style=\"width:12%\"><col style=\"width:124px\"></colgroup>";

    // خلية "المتبقي": الرقم الأحمر لو لسه عليه فلوس، وعلامة "Paid" لو اتسدد
    void RestCell(decimal rest)
    {
        if (rest > 0)
        {
            <span class="rest-due">@rest.ToString("0.00")</span>
        }
        else
        {
            <span class="status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
        }
    }

    // أزرار الصف: أيقونات صغيرة بدل 3 أزرار كبيرة
    async Task RowActions(BillsSystem.Domain.Entities.Bill b)
    {
        <div class="row-actions">
            <a href="@Url.Action("Details", new { id = b.Id })" class="icon-btn icon-btn-view" title="View invoice" aria-label="View invoice"><i class="bi bi-eye"></i></a>
            <a href="@Url.Action("Pdf", new { id = b.Id })" target="_blank" class="icon-btn icon-btn-print" title="Print PDF" aria-label="Print PDF"><i class="bi bi-printer"></i></a>
            <form action="@Url.Action("Delete", new { id = b.Id })" method="post" class="d-inline"
                  onsubmit="return confirmDelete(this, 'Delete this invoice? It will be hidden from reports and its stock will be returned.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="icon-btn icon-btn-danger" title="Delete invoice" aria-label="Delete invoice"><i class="bi bi-trash3"></i></button>
            </form>
        </div>
    }
}

<style>
    .bills-table, .client-subtable {
        table-layout: fixed;
        width: 100%;
    }

    .bills-wrap {
        overflow-x: auto;
    }

        .bills-wrap .bills-table {
            min-width: 1020px;
        }

    .client-group-details > td {
        padding: 0 !important;
    }
</style>

<div class="page-head">
    <div>
        <h4>Sales Invoices</h4>
        <p>@Model.TotalCount @(Model.TotalCount == 1 ? "invoice" : "invoices") in total</p>
    </div>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> New Invoice</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-action="Index" class="filter-bar">
    <div class="filter-search">
        <label class="form-label small text-muted mb-1">SEARCH</label>
        <input name="search" value="@search" class="form-control"
               placeholder="Bill number, client or item name" />
    </div>
    <div>
        <label class="form-label small text-muted mb-1">FROM</label>
        <input type="date" name="from" value="@fromText" class="form-control" />
    </div>
    <div>
        <label class="form-label small text-muted mb-1">TO</label>
        <input type="date" name="to" value="@toText" class="form-control" />
    </div>
    <div class="filter-actions">
        <button type="submit" class="btn btn-save"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-cancel">Reset</a>
    </div>
</form>

<div class="list-card bills-wrap">
    <table class="table mb-0 bills-table">
        @Html.Raw(Cols)
        <thead>
            <tr>
                <th>Bill #</th>
                <th>Date</th>
                <th>Client</th>
                <th>Items</th>
                <th class="num">Total</th>
                <th class="num" title="Total after discounts">Net</th>
                <th class="num">Paid</th>
                <th class="num">Remaining</th>
                <th></th>
            </tr>
        </thead>
        @{
            var billGroups = Model.Items
                .GroupBy(b => b.ClientId)
                .Select(g => g.OrderByDescending(b => b.Id).ToList())
                .OrderByDescending(g => g.Max(b => b.Id))
                .ToList();
        }
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-5">No invoices found</td></tr>
            }
            @foreach (var group in billGroups)
            {
                if (group.Count == 1)
                {
                    var bill = group[0];
                    <tr>
                        <td class="bill-no">#@bill.Id</td>
                        <td class="bill-date">@bill.BillDate.ToString("yyyy/MM/dd")</td>
                        <td class="bill-client">@bill.Client.Name</td>
                        <td>
                            @{
                                Lines(bill);
                            }
                        </td>
                        <td class="num">@bill.BillsTotal.ToString("0.00")</td>
                        <td class="num">@bill.TheNet.ToString("0.00")</td>
                        <td class="num">@bill.PaidUp.ToString("0.00")</td>
                        <td class="num">@{
                            RestCell(bill.TheRest);
                        }
                    </td>
                    <td>@{
                        await RowActions(bill);
                    }
                </td>
            </tr>
        }
                else
        {
            var groupId = "bills-grp-" + group[0].Id;
            <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                role="button" aria-expanded="false" aria-controls="@groupId">
                <td colspan="3">
                    <div class="group-title">
                        <i class="bi bi-chevron-right group-arrow"></i>
                        <span class="group-name">@group[0].Client.Name</span>
                        <span class="group-count" title="Invoices on this page">@group.Count invoices</span>
                    </div>
                </td>
                <td class="text-muted">@group.Sum(b => b.Items.Count) items</td>
                <td class="num">@group.Sum(b => b.BillsTotal).ToString("0.00")</td>
                <td class="num">@group.Sum(b => b.TheNet).ToString("0.00")</td>
                <td class="num">@group.Sum(b => b.PaidUp).ToString("0.00")</td>
                <td class="num">@{
                    RestCell(group.Sum(b => b.TheRest));
                }
            </td>
            <td><div class="row-actions"><span class="group-toggle">Details <i class="bi bi-chevron-down"></i></span></div></td>
        </tr>
        <tr class="client-group-details">
            <td colspan="9">
                <div class="collapse" id="@groupId">
                    <table class="table table-sm mb-0 client-subtable">
                        @Html.Raw(Cols)
                        <tbody>
                            @foreach (var bill in group)
                            {
                                <tr>
                                    <td class="bill-no">#@bill.Id</td>
                                    <td class="bill-date">@bill.BillDate.ToString("yyyy/MM/dd")</td>
                                    <td class="bill-client">@bill.Client.Name</td>
                                    <td>
                                        @{
                                            Lines(bill);
                                        }
                                    </td>
                                    <td class="num">@bill.BillsTotal.ToString("0.00")</td>
                                    <td class="num">@bill.TheNet.ToString("0.00")</td>
                                    <td class="num">@bill.PaidUp.ToString("0.00")</td>
                                    <td class="num">@{
                                        RestCell(bill.TheRest);
                                    }
                                </td>
                                <td>@{
                                    await RowActions(bill);
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </td>
</tr>
                }
            }
</tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-from="@fromText" asp-route-to="@toText" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount invoices)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-from="@fromText" asp-route-to="@toText" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
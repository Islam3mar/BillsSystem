@model IEnumerable<BillsSystem.Domain.Entities.Bill>
@{
    ViewData["Title"] = "Sales Invoices";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sales Invoices</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> New Invoice</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="list-card">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Bill Number</th>
                <th>Bill Date</th>
                <th>Client</th>
                <th>Bills Total</th>
                <th>The Net</th>
                <th>Paid Up</th>
                <th>The Rest</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No invoices yet</td></tr>
            }
            @foreach (var bill in Model)
            {
                <tr>
                    <td>@bill.Id</td>
                    <td>@bill.BillDate.ToString("yyyy/MM/dd")</td>
                    <td>@bill.Client.Name</td>
                    <td>@bill.BillsTotal.ToString("0.00")</td>
                    <td>@bill.TheNet.ToString("0.00")</td>
                    <td>@bill.PaidUp.ToString("0.00")</td>
                    <td>@bill.TheRest.ToString("0.00")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        <form asp-action="Delete" asp-route-id="@bill.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this invoice?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
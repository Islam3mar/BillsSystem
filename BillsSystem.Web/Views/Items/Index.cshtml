@model IEnumerable<BillsSystem.Domain.Entities.Item>
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Items</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> Add New Item</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="list-card">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Company</th>
                <th>Type</th>
                <th>Item Name</th>
                <th>Unit</th>
                <th>Selling Price</th>
                <th>Buying Price</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No items added yet</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ItemType.Company.Name</td>
                    <td>@item.ItemType.Name</td>
                    <td>@item.Name</td>
                    <td>@item.Unit.Name</td>
                    <td>@item.SellingPrice</td>
                    <td>@item.BuyingPrice</td>
                    <td>@item.Notes</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Are you sure you want to delete this item?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
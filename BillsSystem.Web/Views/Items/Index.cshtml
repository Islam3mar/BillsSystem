@model BillsSystem.Application.DTOs.PagedResult<BillsSystem.Domain.Entities.Item>
@{
    ViewData["Title"] = "Items";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Items</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> Add New Item</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small text-muted mb-1">SEARCH</label>
        <input name="search" value="@search" class="form-control" style="min-width:280px"
               placeholder="Item, type or company name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-save"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-cancel">Reset</a>
    </div>
</form>

<div class="list-card">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>Company</th>
                <th>Type</th>
                <th>Item Name</th>
                <th>Unit</th>
                <th>Selling Price</th>
                <th>Buying Price</th>
                <th>Stock</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">@(string.IsNullOrWhiteSpace(search) ? "No items added yet" : "No items match your search")</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.ItemType.Company.Name</td>
                    <td>@item.ItemType.Name</td>
                    <td>@item.Name</td>
                    <td>@item.Unit.Name</td>
                    <td>@item.SellingPrice</td>
                    <td>@item.BuyingPrice</td>
                    <td>@item.QuantityInStock</td>
                    <td>@item.Notes</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirmDelete(this, 'Are you sure you want to delete this item?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="search" value="@search" />
                            <input type="hidden" name="page" value="@Model.Page" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount items)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

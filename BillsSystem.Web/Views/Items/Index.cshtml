@model BillsSystem.Application.DTOs.PagedResult<BillsSystem.Domain.Entities.Item>
@{
    ViewData["Title"] = "Items";
    var search = ViewBag.Search as string;

    // لو فيه بحث نفتح المجموعات أوتوماتيك علشان النتايج تبان على طول
    var expand = !string.IsNullOrWhiteSpace(search);

    const string Cols = "<colgroup><col style=\"width:13%\"><col style=\"width:15%\"><col style=\"width:17%\"><col style=\"width:8%\"><col style=\"width:9%\"><col style=\"width:9%\"><col style=\"width:7%\"><col><col style=\"width:150px\"></colgroup>";

    async Task RowActions(BillsSystem.Domain.Entities.Item row)
    {
        <a href="@Url.Action("Edit", new { id = row.Id })" class="btn btn-sm btn-outline-secondary">Edit</a>
        <form action="@Url.Action("Delete", new { id = row.Id })" method="post" class="d-inline"
              onsubmit="return confirmDelete(this, 'Are you sure you want to delete this item?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="search" value="@search" />
            <input type="hidden" name="page" value="@Model.Page" />
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
    }

    // تجميع باسم الشركة (جوّا الصفحة الحالية)، وجوّاها الأصناف مترتبة بالنوع ثم الاسم
    var groups = Model.Items
        .GroupBy(x => x.ItemType.CompanyId)
        .Select(g => g.OrderBy(x => x.ItemType.Name, StringComparer.OrdinalIgnoreCase)
                      .ThenBy(x => x.Name, StringComparer.OrdinalIgnoreCase).ToList())
        .OrderBy(g => g[0].ItemType.Company.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Items</h4>
    <a asp-action="Create" class="btn btn-save"><i class="bi bi-plus-lg"></i> Add New Item</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label small text-muted mb-1">SEARCH</label>
        <input name="search" value="@search" class="form-control" style="min-width:280px"
               placeholder="Item, type or company name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-save"><i class="bi bi-search"></i> Search</button>
        <a asp-action="Index" class="btn btn-cancel">Reset</a>
    </div>
</form>

<div class="list-card cat-wrap cat-wrap-wide">
    <table class="table mb-0 cat-table">
        @Html.Raw(Cols)
        <thead>
            <tr>
                <th>Company</th>
                <th>Type</th>
                <th>Item Name</th>
                <th>Unit</th>
                <th>Selling Price</th>
                <th>Buying Price</th>
                <th>Stock</th>
                <th>Notes</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!groups.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">@(string.IsNullOrWhiteSpace(search) ? "No items added yet" : "No items match your search")</td></tr>
            }
            @foreach (var group in groups)
            {
                if (group.Count == 1)
                {
                    var one = group[0];
                    <tr>
                        <td class="company-cell">@one.ItemType.Company.Name</td>
                        <td>@one.ItemType.Name</td>
                        <td>@one.Name</td>
                        <td>@one.Unit.Name</td>
                        <td>@one.SellingPrice</td>
                        <td>@one.BuyingPrice</td>
                        <td>@one.QuantityInStock</td>
                        <td>@one.Notes</td>
                        <td class="text-center">@{
                            await RowActions(one);
                        }
                    </td>
                </tr>
            }
                else
            {
                var groupId = "items-grp-" + group[0].ItemType.CompanyId;
                var typesCount = group.Select(x => x.ItemTypeId).Distinct().Count();
                <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                    role="button" aria-expanded="@(expand ? "true" : "false")" aria-controls="@groupId">
                    <td colspan="2">
                        <div class="group-title">
                            <i class="bi bi-chevron-right group-arrow"></i>
                            <span class="group-name">@group[0].ItemType.Company.Name</span>
                            <span class="group-count">@group.Count items</span>
                        </div>
                    </td>
                    <td colspan="6" class="text-muted">@typesCount @(typesCount == 1 ? "type" : "types")</td>
                    <td class="text-center"><span class="group-toggle">Details <i class="bi bi-chevron-down"></i></span></td>
                </tr>
                <tr class="client-group-details">
                    <td colspan="9">
                        <div class="@(expand ? "collapse show" : "collapse")" id="@groupId">
                            <table class="table table-sm mb-0 client-subtable">
                                @Html.Raw(Cols)
                                <tbody>
                                    @foreach (var row in group)
                                    {
                                        <tr>
                                            <td></td>
                                            <td>@row.ItemType.Name</td>
                                            <td>@row.Name</td>
                                            <td>@row.Unit.Name</td>
                                            <td>@row.SellingPrice</td>
                                            <td>@row.BuyingPrice</td>
                                            <td>@row.QuantityInStock</td>
                                            <td>@row.Notes</td>
                                            <td class="text-center">@{
                                                await RowActions(row);
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
        }
    }
</tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages (@Model.TotalCount items)</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}

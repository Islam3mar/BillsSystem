@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p class="text-muted">An error occurred while processing your request. Please try again, or contact support if it keeps happening.</p>

@if (Model.ShowRequestId)
{
    <p class="small text-muted">
        Reference: <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-save">Back to Home</a>

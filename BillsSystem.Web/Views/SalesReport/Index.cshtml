@model BillsSystem.Web.ViewModels.SalesReportFilterViewModel
@using BillsSystem.Application.DTOs
@{
    ViewData["Title"] = "Sales Report";
    var report = ViewBag.Report as SalesReportResult;

    // عرض أسماء الأصناف جوه خلية الفاتورة
    void Lines(BillSummaryDto b)
    {
        foreach (var l in b.Lines)
        {
            <div class="bill-line"><span class="bill-line-name">@l.ItemName</span> <span class="bill-line-qty">&times; @l.Quantity</span></div>
        }
    }
    const string Cols = "<colgroup><col style=\"width:5%\"><col style=\"width:9%\"><col style=\"width:13%\"><col style=\"width:20%\"><col style=\"width:10%\"><col style=\"width:8%\"><col style=\"width:9%\"><col style=\"width:9%\"><col style=\"width:11%\"><col style=\"width:100px\"></colgroup>";

    // خلية "المتبقي": الرقم الأحمر لو لسه عليه فلوس، وعلامة "Paid" لو اتسدد
    void RestCell(decimal rest)
    {
        if (rest > 0)
        {
            <span class="rest-due">@rest.ToString("0.00")</span>
        }
        else
        {
            <span class="status-paid"><i class="bi bi-check-circle-fill"></i> Paid</span>
        }
    }
}

<link rel="stylesheet" href="~/css/report-print.css" asp-append-version="true" media="print" />

<style>
    .bills-table, .client-subtable {
        table-layout: fixed;
        width: 100%;
    }

    .bills-wrap {
        overflow-x: auto;
    }

        .bills-wrap .bills-table {
            min-width: 1100px;
        }

    .client-group-details > td {
        padding: 0 !important;
    }

    .print-only {
        display: none;
    }
</style>

<div class="form-card no-print">
    <h4>Sales Report</h4>

    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-auto">
            <label asp-for="FromDate" class="form-label small text-muted">FROM</label>
            <input asp-for="FromDate" type="date" class="form-control" />
            <span asp-validation-for="FromDate" class="text-danger"></span>
        </div>
        <div class="col-auto">
            <label asp-for="ToDate" class="form-label small text-muted">TO</label>
            <input asp-for="ToDate" type="date" class="form-control" />
            <span asp-validation-for="ToDate" class="text-danger"></span>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-save"><i class="bi bi-funnel"></i> Generate Report</button>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-cancel"><i class="bi bi-x-circle"></i> Reset</a>
        </div>
        @if (report != null)
        {
            <div class="col-auto ms-auto">
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer"></i> Print
                </button>
            </div>
        }
    </form>
</div>

@if (report != null)
{
    <div class="mt-3">
        <!-- ===== Print letterhead (بيظهر في الطباعة بس) ===== -->
        <div class="print-only">
            <div class="rp-letterhead">
                <img src="~/images/pioneers-solutions-logo.png" alt="Pioneers" class="rp-logo" />
                <div class="rp-company">Pioneers Solutions</div>
                <div class="rp-title">SALES REPORT</div>
            </div>
            <div class="rp-rule"></div>
            <div class="rp-meta">
                <div class="rp-box">
                    <div class="rp-box-head">REPORT PERIOD</div>
                    <div class="rp-box-body">
                        <div><span>From</span><b>@report.FromDate.ToString("yyyy/MM/dd")</b></div>
                        <div><span>To</span><b>@report.ToDate.ToString("yyyy/MM/dd")</b></div>
                    </div>
                </div>
                <div class="rp-box">
                    <div class="rp-box-head">REPORT DETAILS</div>
                    <div class="rp-box-body">
                        <div><span>Invoices</span><b>@report.BillsCount</b></div>
                        <div><span>Printed on</span><b>@BillsSystem.Domain.Common.AppClock.Today.ToString("yyyy/MM/dd")</b></div>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="mb-3 no-print">
            Report Period: @report.FromDate.ToString("yyyy/MM/dd") &rarr; @report.ToDate.ToString("yyyy/MM/dd")
        </h5>

        <!-- ===== KPI Cards ===== -->
        <div class="row g-3 report-kpis">
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">TOTAL BILLS</div>
                    <div class="fs-4 fw-bold">@report.BillsCount</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">TOTAL SALES (Before Discount)</div>
                    <div class="fs-4 fw-bold">@report.TotalBillsAmount.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">TOTAL DISCOUNTS</div>
                    <div class="fs-4 fw-bold text-danger">@report.TotalDiscounts.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">NET SALES</div>
                    <div class="fs-4 fw-bold text-success">@report.TotalNetSales.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">PAID ON THESE INVOICES</div>
                    <div class="fs-4 fw-bold">@report.TotalCollected.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">OUTSTANDING (CLIENTS OWE)</div>
                    <div class="fs-4 fw-bold text-warning">@report.TotalOutstanding.ToString("0.00")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="list-card p-3 text-center">
                    <div class="text-muted small">AVG. BILL VALUE</div>
                    <div class="fs-4 fw-bold">@report.AverageBillValue.ToString("0.00")</div>
                </div>
            </div>
        </div>

        <!-- ===== Top Items / Top Clients ===== -->
        <div class="row g-3 mt-1 report-tops">
            <div class="col-md-6">
                <div class="list-card p-3">
                    <h6>Top Selling Items</h6>
                    @if (!report.TopSellingItems.Any())
                    {
                        <p class="text-muted mb-0">No sales in this period</p>
                    }
                    else
                    {
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr><th>Item</th><th>Unit</th><th class="text-end">Qty</th><th class="text-end">Revenue</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in report.TopSellingItems)
                                {
                                    <tr>
                                        <td>@item.ItemName</td>
                                        <td>@item.UnitName</td>
                                        <td class="text-end">@item.QuantitySold</td>
                                        <td class="text-end">@item.TotalRevenue.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="list-card p-3">
                    <h6>Top Clients</h6>
                    @if (!report.TopClients.Any())
                    {
                        <p class="text-muted mb-0">No sales in this period</p>
                    }
                    else
                    {
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr><th>Client</th><th class="text-end">Bills</th><th class="text-end">Net Sales</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var client in report.TopClients)
                                {
                                    <tr>
                                        <td>@client.ClientName</td>
                                        <td class="text-end">@client.BillsCount</td>
                                        <td class="text-end">@client.TotalNet.ToString("0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- ===== Bills Table ===== -->
        <div class="list-card bills-wrap mt-3">
            <table class="table mb-0 bills-table">
                @Html.Raw(Cols)
                <thead>
                    <tr>
                        <th>Bill #</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Items</th>
                        <th class="num">Total (Before Discount)</th>
                        <th class="num">Discounts</th>
                        <th class="num" title="Total after discounts">Net</th>
                        <th class="num">Paid</th>
                        <th class="num">Remaining</th>
                        <th class="no-print"></th>
                    </tr>
                </thead>
                @{
                    var reportGroups = report.Bills
                        .GroupBy(b => b.ClientName)
                        .Select(g => g.OrderByDescending(b => b.Id).ToList())
                        .OrderByDescending(g => g.Max(b => b.Id))
                        .ToList();
                }
                <tbody>
                    @if (!report.Bills.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-5">No invoices in this period</td></tr>
                    }
                    @foreach (var group in reportGroups)
                    {
                        if (group.Count == 1)
                        {
                            var bill = group[0];
                            <tr>
                                <td class="bill-no">#@bill.Id</td>
                                <td class="bill-date">@bill.BillDate.ToString("yyyy/MM/dd")</td>
                                <td class="bill-client">@bill.ClientName</td>
                                <td>
                                    @{
                                        Lines(bill);
                                    }
                                </td>
                                <td class="num">@bill.GrossTotal.ToString("0.00")</td>
                                <td class="num">@bill.TotalDiscount.ToString("0.00")</td>
                                <td class="num">@bill.TheNet.ToString("0.00")</td>
                                <td class="num">@bill.PaidUp.ToString("0.00")</td>
                                <td class="num">@{
                                    RestCell(bill.TheRest);
                                }
                            </td>
                            <td class="no-print">
                                <div class="row-actions">
                                    <a asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id" class="icon-btn icon-btn-view" title="View invoice" aria-label="View invoice"><i class="bi bi-eye"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                        else
                    {
                        var groupId = "report-grp-" + group[0].Id;
                        <tr class="client-group-row" data-bs-toggle="collapse" data-bs-target="#@groupId"
                            role="button" aria-expanded="false" aria-controls="@groupId">
                            <td colspan="3">
                                <div class="group-title">
                                    <i class="bi bi-chevron-right group-arrow"></i>
                                    <span class="group-name">@group[0].ClientName</span>
                                    <span class="group-count" title="Invoices in this period">@group.Count invoices</span>
                                </div>
                            </td>
                            <td class="text-muted">@group.Sum(b => b.ItemsCount) items</td>
                            <td class="num">@group.Sum(b => b.GrossTotal).ToString("0.00")</td>
                            <td class="num">@group.Sum(b => b.TotalDiscount).ToString("0.00")</td>
                            <td class="num">@group.Sum(b => b.TheNet).ToString("0.00")</td>
                            <td class="num">@group.Sum(b => b.PaidUp).ToString("0.00")</td>
                            <td class="num">@{
                                RestCell(group.Sum(b => b.TheRest));
                            }
                        </td>
                        <td class="no-print"><div class="row-actions"><span class="group-toggle">Details <i class="bi bi-chevron-down"></i></span></div></td>
                    </tr>
                    <tr class="client-group-details">
                        <td colspan="10">
                            <div class="collapse" id="@groupId">
                                <table class="table table-sm mb-0 client-subtable">
                                    @Html.Raw(Cols)
                                    <tbody>
                                        @foreach (var bill in group)
                                        {
                                            <tr>
                                                <td class="bill-no">#@bill.Id</td>
                                                <td class="bill-date">@bill.BillDate.ToString("yyyy/MM/dd")</td>
                                                <td class="bill-client">@bill.ClientName</td>
                                                <td>
                                                    @{
                                                        Lines(bill);
                                                    }
                                                </td>
                                                <td class="num">@bill.GrossTotal.ToString("0.00")</td>
                                                <td class="num">@bill.TotalDiscount.ToString("0.00")</td>
                                                <td class="num">@bill.TheNet.ToString("0.00")</td>
                                                <td class="num">@bill.PaidUp.ToString("0.00")</td>
                                                <td class="num">@{
                                                    RestCell(bill.TheRest);
                                                }
                                            </td>
                                            <td class="no-print">
                                                <div class="row-actions">
                                                    <a asp-controller="Bills" asp-action="Details" asp-route-id="@bill.Id" class="icon-btn icon-btn-view" title="View invoice" aria-label="View invoice"><i class="bi bi-eye"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
    @if (report.Bills.Any())
    {
        <tfoot>
            <tr class="report-totals">
                <td colspan="4" class="num">Totals</td>
                <td class="num">@report.TotalBillsAmount.ToString("0.00")</td>
                <td class="num">@report.TotalDiscounts.ToString("0.00")</td>
                <td class="num">@report.TotalNetSales.ToString("0.00")</td>
                <td class="num">@report.TotalCollected.ToString("0.00")</td>
                <td class="num">@report.TotalOutstanding.ToString("0.00")</td>
                <td class="no-print"></td>
            </tr>
        </tfoot>
    }
</table>
</div>
</div>
}
